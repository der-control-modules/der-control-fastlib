[bandit]
# Bandit configuration - exclude all test files and development scripts
exclude_dirs = tests,__pycache__
exclude = test_rpc.py,dev_new.py,new_init_project.py,debug_rpc.py,scoop-files-for-model.py
# Skip the following security checks:
# B101: assert statements (acceptable in validation)
# B110: try/except pass (acceptable for optional operations)
# B307: eval usage (already fixed with ast.literal_eval)
# B404: subprocess import (needed for git operations)
# B603: subprocess without shell (intentional for security)
# B607: subprocess with partial path (git is expected to be in PATH)
skips = B101,B110,B307,B404,B603,B607
