# Copy to .env in this directory to override defaults for local development.
# No secret values belong in this file.

# Sibling checkout this image's package directory is copied from at build
# time. No default: build.sh archives it and exports DER_AGENT_SRC itself,
# so compose never resolves a raw, uncommitted checkout on its own (#68).
# Set it here only to start an image build.sh already produced, without
# invoking a build: any value works, since compose never reads the path
# unless a build actually runs.
#DER_AGENT_SRC=unused
