# Copy to .env in this directory to override defaults for local development.
# No secret values belong in this file; JWT_SECRET_KEY (#52) arrives as a
# compose secret from docker/secrets/, never as an environment value here.

# Host interface the published port binds to. Defaults to loopback only.
# If a 127.0.0.1 publish does not answer on this host, set this to
# 127.0.0.2 instead (also loopback-only; some hosts route 127.0.0.1 traffic
# away from the published port before it reaches Docker).
DERHOST_PUBLISH_HOST=127.0.0.1
