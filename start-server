#!/bin/bash

# Start AEMS Server
# This script starts the AEMS message bus server with the configuration from launch.json

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export VOLTTRON_HOME="$SCRIPT_DIR/.volttron_home"

echo "Starting AEMS Server..."
echo "VOLTTRON_HOME: $VOLTTRON_HOME"

"$SCRIPT_DIR/.venv/bin/python" -m aems.server.fastapi_message_bus \
    --host 0.0.0.0 \
    --port 8000
